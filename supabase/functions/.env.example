# Copy this file outside source control and replace every placeholder.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied automatically after
# hosted deployment; local function serving obtains them from the local stack.
AI_API_KEY=REPLACE_WITH_SERVER_ONLY_GEMINI_KEY
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# Older deployments may use AI_FALLBACK_MODEL for one fallback instead.
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT_MS=80000
AI_ATTEMPT_TIMEOUT_MS=32000
QUIZ_GENERATION_PER_MINUTE=3
ALLOWED_ORIGIN=*
