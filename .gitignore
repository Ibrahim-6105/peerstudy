# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/android/build/

# Local release-signing credentials must never enter source control.
/android/key.properties
*.jks
*.keystore

# Local Firebase emulator configuration may contain provider secrets.
/functions/.env.local
/functions/.secret.local
/firebase-debug.log
/firestore-debug.log
/ui-debug.log

# A local handoff APK is generated from source and should not enter Git history.
/PeerStudy-local-emulator-test.apk
/PeerStudy-phone-USB-test.apk
/PeerStudy-phone-ARM64-USB-test.apk
/PeerStudy-phone-test.apk

# Supabase migrations, Edge Functions, seeds, and config are source code.
# Only machine-specific CLI link/cache state stays outside version control.
/supabase/.temp/
/supabase/.branches/
/supabase/.env
/supabase/functions/.env

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
